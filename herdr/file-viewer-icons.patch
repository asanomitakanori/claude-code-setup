+#[cfg(test)]
+mod tests {
+    use super::*;
+    use ratatui::text::Span;
+
+    #[test]
+    fn parse_is_lenient() {
+        assert_eq!(Mode::parse(Some(" Nerd-Font ")), Mode::Nerd);
+        assert_eq!(Mode::parse(Some("EMOJI")), Mode::Emoji);
+        assert_eq!(Mode::parse(Some("none")), Mode::Off);
+        assert_eq!(Mode::parse(None), Mode::Off);
+    }
+
+    #[test]
+    fn nerd_tables_give_distinct_one_cell_glyphs() {
+        let json = nerd_file_icon("package-lock.json");
+        let md = nerd_file_icon("README.md");
+        let yaml = nerd_file_icon("ci.yml");
+        assert_ne!(json.0, md.0);
+        assert_ne!(md.0, yaml.0);
+        assert_ne!(json.0, DEFAULT_FILE.0);
+        assert_eq!(nerd_file_icon("Dockerfile"), nerd_file_icon("DOCKERFILE"));
+        assert_eq!(nerd_file_icon("noext"), DEFAULT_FILE);
+        assert_eq!(nerd_dir_icon("whatever", false), DEFAULT_DIR);
+        assert_eq!(nerd_dir_icon("whatever", true), DEFAULT_DIR_OPEN);
+        assert_ne!(nerd_dir_icon("src", false), DEFAULT_DIR);
+        for g in [
+            DEFAULT_FILE.0,
+            DEFAULT_DIR.0,
+            DEFAULT_DIR_OPEN.0,
+            json.0,
+            md.0,
+            yaml.0,
+        ] {
+            assert_eq!(Span::raw(g).width(), 1, "{g:?}");
+        }
+    }
+
+    #[test]
+    fn emoji_table_gives_two_cell_glyphs() {
+        for name in [
+            "a.json",
+            "b.md",
+            "c.py",
+            "Dockerfile",
+            "README",
+            "x.unknown",
+            "noext",
+            "d.png",
+            "e.c",
+        ] {
+            let (g, _) = emoji_file_icon(&name.to_ascii_lowercase());
+            assert_eq!(Span::raw(g).width(), 2, "{name} -> {g:?}");
+        }
+        assert_ne!(emoji_file_icon("a.json").0, emoji_file_icon("b.md").0);
+        assert_ne!(emoji_file_icon("a.json").0, emoji_file_icon("noext").0);
+    }
+}

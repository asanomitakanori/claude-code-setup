+//! File and folder icons for the tree (a local addition: the upstream project keeps the tree plain,
+//! see smarzban/herdr-file-viewer#153). Selected by `file_icons` in the plugin's `config.toml`:
+//! `"nerd-font"` for per-type Nerd Font glyphs, `"emoji"` for a smaller set of color emoji that any
+//! modern terminal can draw without a patched font, anything else for the plain upstream tree.
+//!
+//! The glyph/color table was generated from mini.icons (echasnovski/mini.icons), the icon source
+//! LazyVim uses, so a file shows the same icon here as in neovim's file pickers. Every glyph is a
+//! single-cell Nerd Font v3 codepoint; a terminal without a Nerd Font shows a placeholder box.
+
+use ratatui::style::Color;
+use std::sync::atomic::{AtomicU8, Ordering};
+
+/// Which icon vocabulary the tree draws, if any.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub enum Mode {
+    /// The plain upstream tree: no icon column.
+    #[default]
+    Off,
+    /// One-cell Nerd Font v3 glyphs, per file type (needs a Nerd Font in the terminal).
+    Nerd,
+    /// Two-cell color emoji, a coarser per-type set that needs no special font.
+    Emoji,
+}
+
+impl Mode {
+    /// Lenient parse of the `file_icons` config value: trimmed, case-insensitive; unknown → `Off`.
+    pub fn parse(value: Option<&str>) -> Mode {
+        match value.map(|s| s.trim().to_ascii_lowercase()).as_deref() {
+            Some("nerd-font" | "nerd" | "nerdfont" | "nerd_font") => Mode::Nerd,
+            Some("emoji" | "unicode") => Mode::Emoji,
+            _ => Mode::Off,
+        }
+    }
+}
+
+static MODE: AtomicU8 = AtomicU8::new(0);
+
+/// Select the icon mode for the whole process. Called once at startup from the loaded config; the
+/// presenter reads it on every tree render.
+pub fn set_mode(mode: Mode) {
+    MODE.store(mode as u8, Ordering::Relaxed);
+}
+
+/// The icon mode in effect.
+pub fn mode() -> Mode {
+    match MODE.load(Ordering::Relaxed) {
+        1 => Mode::Nerd,
+        2 => Mode::Emoji,
+        _ => Mode::Off,
+    }
+}
+
+/// Whether tree rows carry an icon before the name.
+pub fn enabled() -> bool {
+    mode() != Mode::Off
+}
+
+const DEFAULT_FILE: (&str, Color) = ("\u{f0214}", Color::Gray);
+const DEFAULT_DIR: (&str, Color) = ("\u{f024b}", Color::LightBlue);
+/// nf-md-folder_open: the generic folder's expanded state.
+const DEFAULT_DIR_OPEN: (&str, Color) = ("\u{f0770}", Color::LightBlue);
+
+/// The icon for a directory row in the current mode. In Nerd mode a well-known directory name
+/// (`src`, `tests`, `.github`, …) keeps its own glyph whether expanded or not; any other folder
+/// flips between the closed and open folder glyphs so the expand arrow is not the only cue.
+pub fn dir_icon(name: &str, expanded: bool) -> (&'static str, Color) {
+    match mode() {
+        Mode::Emoji if expanded => ("\u{1f4c2}", Color::Reset),
+        Mode::Emoji => ("\u{1f4c1}", Color::Reset),
+        _ => nerd_dir_icon(name, expanded),
+    }
+}
+
+/// The icon for a file row in the current mode: an exact (case-insensitive) file name first, then
+/// the extension after the last dot, then the generic file glyph.
+pub fn file_icon(name: &str) -> (&'static str, Color) {
+    match mode() {
+        Mode::Emoji => emoji_file_icon(&name.to_ascii_lowercase()),
+        _ => nerd_file_icon(name),
+    }
+}
+
+/// Color emoji for the common file kinds. Every entry is a two-cell emoji (text-presentation
+/// symbols such as `⚙` get an explicit VS16 so terminals agree on the width), so rows stay aligned.
+fn emoji_file_icon(lower: &str) -> (&'static str, Color) {
+    let c = Color::Reset;
+    match lower {
+        "dockerfile" | "containerfile" => return ("\u{1f433}", c), // 🐳
+        "makefile" | "justfile" | "cmakelists.txt" => return ("\u{1f527}", c), // 🔧
+        "license" | "license.md" | "license.txt" | "copying" => return ("\u{2696}\u{fe0f}", c), // ⚖️
+        ".gitignore" | ".gitattributes" | ".gitmodules" => return ("\u{1f6ab}", c), // 🚫
+        _ => {}
+    }
+    if lower.starts_with("readme") {
+        return ("\u{1f4d6}", c); // 📖
+    }
+    let ext = lower.rsplit_once('.').map(|(_, e)| e).unwrap_or("");
+    let g = match ext {
+        "md" | "mdx" | "markdown" | "rst" | "adoc" | "org" => "\u{1f4dd}", // 📝
+        "json" | "jsonc" | "json5" | "toml" | "yaml" | "yml" | "ini" | "cfg" | "conf" | "env" => {
+            "\u{1f9e9}" // 🧩
+        }
+        "py" | "pyi" | "ipynb" => "\u{1f40d}",            // 🐍
+        "rs" => "\u{1f980}",                              // 🦀
+        "go" => "\u{1f439}",                              // 🐹
+        "js" | "mjs" | "cjs" | "jsx" => "\u{1f7e8}",      // 🟨
+        "ts" | "tsx" => "\u{1f7e6}",                      // 🟦
+        "html" | "htm" | "vue" | "svelte" => "\u{1f310}", // 🌐
+        "css" | "scss" | "sass" | "less" => "\u{1f3a8}",  // 🎨
+        "sh" | "bash" | "zsh" | "fish" | "ps1" | "bat" => "\u{1f4dc}", // 📜
+        "lua" | "vim" => "\u{1f319}",                     // 🌙
+        "c" | "h" | "cpp" | "cc" | "cxx" | "hpp" | "hh" | "java" | "kt" | "cs" | "swift" => {
+            "\u{2699}\u{fe0f}" // ⚙️
+        }
+        "sql" | "db" | "sqlite" | "sqlite3" | "csv" | "tsv" | "parquet" => "\u{1f4ca}", // 📊
+        "png" | "jpg" | "jpeg" | "gif" | "webp" | "bmp" | "ico" | "svg" | "tif" | "tiff"
+        | "psd" => {
+            "\u{1f5bc}\u{fe0f}" // 🖼️
+        }
+        "mp4" | "mov" | "mkv" | "avi" | "webm" => "\u{1f3ac}", // 🎬
+        "mp3" | "wav" | "flac" | "ogg" => "\u{1f3b5}",         // 🎵
+        "zip" | "tar" | "gz" | "tgz" | "bz2" | "xz" | "zst" | "7z" | "rar" => "\u{1f4e6}", // 📦
+        "pdf" => "\u{1f4d5}",                                  // 📕
+        "lock" | "pem" | "key" | "crt" => "\u{1f512}",         // 🔒
+        "txt" | "log" => "\u{1f4c3}",                          // 📃
+        "pt" | "pth" | "ckpt" | "safetensors" | "onnx" | "npy" | "npz" | "pkl" | "h5" => {
+            "\u{1f9e0}" // 🧠
+        }
+        _ => "\u{1f4c4}", // 📄
+    };
+    (g, c)
+}
+
+fn nerd_dir_icon(name: &str, expanded: bool) -> (&'static str, Color) {
+    match name.to_ascii_lowercase().as_str() {
+        "src" => ("\u{f0d09}", Color::Magenta),
+        ".git" => ("\u{0e5fb}", Color::LightRed),
+        "node_modules" => ("\u{0e5fa}", Color::Green),
+        ".github" => ("\u{0e5fd}", Color::LightBlue),
+        "test" | "tests" => ("\u{f178a}", Color::Blue),
+        "doc" | "docs" => ("\u{f10b7}", Color::Magenta),
+        ".config" => ("\u{f107f}", Color::Cyan),
+        ".claude" | ".idea" | ".venv" | ".vscode" | "__pycache__" | "api" | "apps" | "assets"
+        | "benchmarks" | "cache" | "cmake" | "components" | "config" | "data" | "deploy"
+        | "dist" | "examples" | "experiments" | "fonts" | "hooks" | "images" | "img"
+        | "include" | "infra" | "k8s" | "logs" | "migrations" | "models" | "notebooks"
+        | "outputs" | "packages" | "pages" | "public" | "results" | "scripts" | "services"
+        | "static" | "styles" | "target" | "terraform" | "third_party" | "types" | "utils"
+        | "vendor" | "venv" => ("\u{f024b}", Color::LightBlue),
+        "build" => ("\u{f19fc}", Color::Gray),
+        "lib" => ("\u{f0c82}", Color::Yellow),
+        "bin" => ("\u{f19fa}", Color::Yellow),
+        "tmp" => ("\u{f0aba}", Color::Yellow),
+        "home" => ("\u{f10b5}", Color::Yellow),
+        "downloads" => ("\u{f024d}", Color::LightRed),
+        "desktop" => ("\u{f069d}", Color::LightRed),
+        "documents" => ("\u{f19f6}", Color::LightRed),
+        "pictures" => ("\u{f024f}", Color::LightRed),
+        "videos" => ("\u{f178a}", Color::LightRed),
+        "music" => ("\u{f1359}", Color::LightRed),
+        ".cache" => ("\u{f0aba}", Color::Cyan),
+        _ if expanded => DEFAULT_DIR_OPEN,
+        _ => DEFAULT_DIR,
+    }
+}
+
+fn nerd_file_icon(name: &str) -> (&'static str, Color) {
+    let lower = name.to_ascii_lowercase();
+    match lower.as_str() {
+        "dockerfile" => ("\u{f0868}", Color::Blue),
+        "compose.yaml" | "docker-compose.yml" | "pnpm-lock.yaml" | "yarn.lock" => {
+            ("\u{0e6a8}", Color::Magenta)
+        }
+        "makefile" => ("\u{f1064}", Color::Gray),
+        "cmakelists.txt" => ("\u{f1064}", Color::LightRed),
+        "license" | "license.md" => ("\u{0e60a}", Color::Cyan),
+        "readme" | "readme.md" => ("\u{0f4ed}", Color::Yellow),
+        "changelog.md" => ("\u{f027b}", Color::Blue),
+        "cargo.lock" | "cargo.toml" | "pyproject.toml" | "uv.lock" => {
+            ("\u{0e6b2}", Color::LightRed)
+        }
+        ".eslintrc" | ".eslintrc.json" | ".prettierrc" | "flake.lock" | "jsconfig.json"
+        | "package-lock.json" | "package.json" | "tsconfig.json" => ("\u{f0626}", Color::Yellow),
+        "requirements.txt" => ("\u{f160e}", Color::Magenta),
+        "setup.py" => ("\u{f0320}", Color::Yellow),
+        "go.mod" => ("\u{f0afa}", Color::Cyan),
+        "go.sum" => ("\u{f07d3}", Color::Cyan),
+        "gemfile" | "vagrantfile" => ("\u{f0d2d}", Color::Red),
+        ".gitignore" => ("\u{f02a2}", Color::Magenta),
+        ".gitattributes" => ("\u{f02a2}", Color::Yellow),
+        ".gitmodules" => ("\u{f0493}", Color::LightRed),
+        ".gitlab-ci.yml" => ("\u{f0ba0}", Color::LightRed),
+        ".editorconfig" => ("\u{0e652}", Color::Gray),
+        ".npmrc" => ("\u{f0bc2}", Color::LightBlue),
+        ".bashrc" | ".nvmrc" | ".zshrc" => ("\u{f0493}", Color::Green),
+        ".dockerignore" => ("\u{f0868}", Color::LightRed),
+        ".vimrc" => ("\u{0e7c5}", Color::Green),
+        "init.lua" => ("\u{0f36f}", Color::Green),
+        "vite.config.ts" => ("\u{f06e6}", Color::LightBlue),
+        "next.config.js" | "tailwind.config.js" | "webpack.config.js" => {
+            ("\u{f031e}", Color::Yellow)
+        }
+        "justfile" => ("\u{f05b7}", Color::LightRed),
+        "flake.nix" => ("\u{f1105}", Color::LightBlue),
+        "codeowners" => ("\u{f073b}", Color::Magenta),
+        "agents.md" | "claude.md" => ("\u{f0354}", Color::Gray),
+        "robots.txt" => ("\u{f06a9}", Color::Gray),
+        _ => by_extension(&lower),
+    }
+}
+
+fn by_extension(lower_name: &str) -> (&'static str, Color) {
